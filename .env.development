# ─── Development overrides ───────────────────────────────────────────────────
# File ini di-load otomatis oleh Vite saat `npm run dev` dan TIDAK pernah
# menimpa .env.production / build. Aman di-commit — tidak mengandung secret.

VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=15000
VITE_APP_PORT=5173

# Nomor WhatsApp admin Loka (tanpa +, format internasional: 62xxx)
VITE_ADMIN_WHATSAPP=6283878960539

# Cloudflare Turnstile — test key resmi dari Cloudflare:
#   "1x00000000000000000000AA" → selalu lolos (visible widget)
#   "2x00000000000000000000AB" → selalu lolos (invisible)
# Catatan: captcha.ts sudah set CAPTCHA_ENABLED=false saat DEV, jadi widget
# tidak ditampilkan sama sekali dan token "dev-no-captcha" dikirim sebagai
# gantinya. Pastikan backend localhost dikonfigurasi tanpa CAPTCHA_SECRET_KEY
# agar token itu diterima.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
